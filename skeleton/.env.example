# 환경변수 — 실제 값은 .env 에 채우고 커밋하지 않는다 (ARCHITECTURE.md §5, §17)
# 설정 코드(app/config.py)는 형제 FastAPI 템플릿과 공유한다. 이 템플릿이 쓰지 않는 키
# (ACCESS_TOKEN_EXPIRE_MINUTES·REFRESH_TOKEN_TRANSPORT·CORS_ORIGINS·FRONTEND_URL·BACKEND_PUBLIC_URL)는 두지 않는다.

# DB (psql 로 생성한 데이터베이스)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/__PROJECT_SNAKE__

# 실행 환경 — development | test | production (그 밖의 값은 기동 거부).
# production 이면 안전하지 않은 설정(기본·32 bytes 미만 SECRET_KEY, 관리자 시드, Secure 없는 인증 쿠키,
# BCRYPT_ROUNDS 12 미만)으로 기동하지 않는다.
APP_ENV=development

# 로그 수준 — app.* 로거(감사 로그 app.audit 포함). DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 서명 키 — Flask 서명 쿠키(flash·CSRF 토큰)에 쓴다. ⛔ 아래 값은 저장소에 공개된 기본값이다. 반드시 무작위 키로 교체한다.
#           openssl rand -hex 32   (스캐폴드가 자동으로 무작위 키를 넣어준다)
SECRET_KEY=change-me-in-production-use-32-bytes

# 로그인 세션 수명(일) — auth_sessions 행과 인증 쿠키의 만료. 키 이름은 공통 설정(config.py)을 따른다.
REFRESH_TOKEN_EXPIRE_DAYS=14

# 로그인 시도 제한 — 계정별 연속 실패가 MAX 이상이면 LOCKOUT 분 동안 429 로 거부한다.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# bcrypt 비용 — 기본 12. 운영(production)에서는 12 미만이면 기동을 거부한다(테스트만 낮춘다).
# BCRYPT_ROUNDS=12

# 인증·flash 쿠키의 Secure 속성. HTTPS 운영에서는 반드시 true — ⛔ APP_ENV=production 에서 false 면 기동을 거부한다.
COOKIE_SECURE=false

# 업로드 저장소 — 상대 경로는 프로젝트 루트 기준(기본 uploads, .gitignore 대상).
# public/ 아래(본문·배너 이미지)만 /uploads/public 으로 서빙되고, private/(공지 첨부)는 다운로드 경로로만 내려간다.
UPLOAD_DIR=uploads
# 공개 파일·첨부 다운로드 URL 의 접두사. 같은 오리진에서 서빙하면 비워 둔다(루트 상대 경로).
PUBLIC_FILES_BASE_URL=
# 업로드 크기 상한(MB) — 이미지(본문·배너) / 공지 첨부
MAX_IMAGE_UPLOAD_MB=5
MAX_ATTACHMENT_UPLOAD_MB=20

# 프로세스 시각대 — Unix 에서만 적용(tzset, 외부 라이브러리용). 앱 시각(now())·로그는 이 값·OS 와 무관하게 KST 다.
TZ=Asia/Seoul

# 초기 시드 — 기본 관리자(admin) 자동 생성. 코드 기본값은 꺼져 있고(config.py), 여기서만 켠다.
# ⛔ APP_ENV=production 에서 true 면 기동을 거부한다. 운영에서는 python -m app.cli create-admin 으로 만든다.
# DEFAULT_ADMIN_PASSWORD 는 비워 둘 수 없다(비면 시드를 건너뛰고 에러 로그를 남긴다). UTF-8 기준 72 bytes 이하.
SEED_DEFAULT_ADMIN=true
DEFAULT_ADMIN_PASSWORD=
